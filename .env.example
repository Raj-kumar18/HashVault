# ========================================================
# LogSentinel - Master Environment Configuration Template
# Copy this file to .env (or respective backend/.env and frontend/.env)
# ========================================================

# --- Backend Configuration ---
# Server port (defaults to 5001 to prevent macOS ControlCenter AirPlay conflict on 5000)
PORT=5001

# Application environment: development | test | production
NODE_ENV=development

# MongoDB Connection String (e.g. mongodb://localhost:27017/logsentinel or Atlas URI)
# When omitted or unreachable in development, backend runs in database-detached mode.
MONGODB_URI=mongodb://localhost:27017/logsentinel

# Strong secret used to encrypt and sign express session cookies (min 32 characters in production)
SESSION_SECRET=change_this_to_a_secure_cryptographic_random_string_of_at_least_32_characters

# Frontend origin allowed by backend CORS with credentials enabled
CORS_ORIGIN=http://localhost:5173

# Optional: Initial admin account provisioning credentials (used by `npm run seed:admin`)
ADMIN_EMAIL=admin@logsentinel.local
ADMIN_PASSWORD=ReplaceWithStrongPassword2026!
ADMIN_NAME=Security Administrator

# --- Frontend Configuration ---
# Base API URL used by the Vite client to connect to backend
VITE_API_BASE_URL=http://localhost:5001/api

# --- Phase 5: Blockchain Checkpoint Registry Configuration ---
BLOCKCHAIN_ENABLED=true
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_NETWORK_NAME=Hardhat Localhost
BLOCKCHAIN_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# Development-only Hardhat account #0 private key. NEVER commit production keys.
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
LOGSENTINEL_APPLICATION_ID=logsentinel-default-app
BLOCKCHAIN_CONFIRMATIONS=1

# --- Phase 8: Sentinel AI Autonomous Investigation Engine Configuration ---
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_MAX_EVIDENCE_ITEMS=100


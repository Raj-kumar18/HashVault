    "test:collector": "npm --prefix collector test",
    "test:blockchain": "npm --prefix blockchain test",
    "test:security": "npm --prefix backend run test:security",
    "test:all": "npm --prefix backend test && npm --prefix collector test && npm --prefix blockchain test",

    "test:auth": "node --test tests/auth.test.js",
    "test:server": "node --test tests/server.test.js",
    "test:ingestion": "node --test tests/collectorIngestion.test.js",
    "test:e2e": "node --test tests/collectorE2E.test.js",
    "test:integrity": "node --test tests/integrity.test.js",
    "test:checkpoint": "node --test tests/checkpoint.test.js",
    "test:monitoring": "node --test tests/monitoring.test.js",
    "test:dashboard": "node --test tests/dashboard.test.js",
    "test:ai": "node --test tests/sentinelAi.test.js",
    "test:security": "node --test tests/securityRegression.test.js",
